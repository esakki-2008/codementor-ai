# Copy to .env and replace placeholders. Never commit backend/.env.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require

# Generate a unique random secret (at least 32 characters) for JWT signing.
# Example command on Windows PowerShell:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

AUTO_CREATE_TABLES=true
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
