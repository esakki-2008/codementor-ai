# Copy to .env and replace the placeholder with your Neon connection string.
# Never commit backend/.env or share its contents.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require

# Set true for local MVP development. Use Alembic migrations before production.
AUTO_CREATE_TABLES=true

# Comma-separated frontend origins allowed to call this API.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
